# 부팅하면 gesture_pi.py 를 자동으로 켜고, 죽으면 3초 뒤 다시 켜는 설정 (setup.sh 가 설치함)
[Unit]
Description=Snaptune gesture recognizer (webcam)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__DIR__/.venv/bin/python -u gesture_pi.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
